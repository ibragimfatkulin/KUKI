generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String              @id @default(cuid())
  email        String              @unique
  passwordHash String
  name         String              @default("Гость")
  createdAt    DateTime            @default(now())
  recipes      Recipe[]
  favorites    Favorite[]
  history      GenerationHistory[]
}

model Recipe {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  description  String
  cookingTime  Int
  servings     Int
  difficulty   String
  calories     Int
  protein      Float
  fat          Float
  carbs        Float
  instructions String
  imageUrl     String
  equipment    String
  mealType     String
  goal         String
  usagePercent Int
  assumptions  String
  source       String
  notice       String?
  requestJson  String
  exampleKey   String?
  isExample    Boolean             @default(false)
  createdAt    DateTime            @default(now())
  ingredients  Ingredient[]
  favorites    Favorite[]
  history      GenerationHistory[]

  @@index([userId, createdAt])
  @@index([userId, exampleKey])
}

model Ingredient {
  id          String  @id @default(cuid())
  recipeId    String
  recipe      Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  name        String
  quantity    Float?
  unit        String?
  isAvailable Boolean @default(true)
  assumed     Boolean @default(false)
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  recipeId  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe    Recipe   @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([userId, recipeId])
  @@index([userId, createdAt])
}

model GenerationHistory {
  id               String   @id @default(cuid())
  userId           String
  recipeId         String?
  inputIngredients String
  equipment        String
  settings         String
  createdAt        DateTime @default(now())
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe           Recipe?  @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}
