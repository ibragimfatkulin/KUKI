DATABASE_URL="file:./dev.db"

# Turso. Если обе строки заполнены, рецепты пишутся в облачную SQLite.
# Пустые значения оставляют локальный файл из DATABASE_URL.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# Ключ только на сервере. Пустое значение включает локальный кулинарный модуль.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
